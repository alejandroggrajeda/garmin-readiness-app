# Copy to `mobile/.env` for local development. NEVER commit the real
# `mobile/.env` file (already covered by `mobile/.gitignore`'s `.env*` rule).
#
# Expo inlines any `EXPO_PUBLIC_*` variable into the JS bundle at build/dev
# time (supported natively since Expo SDK 49 - no extra dependency needed).
# This is a personal, single-user app with no per-user auth system, so the
# static API key is configured this way rather than via secure on-device
# storage (see `src/api/client.ts`'s docstring for the full reasoning).
#
# IMPORTANT: because EXPO_PUBLIC_* values are bundled into the client, treat
# this key the same way you'd treat a "don't put real secrets in a mobile
# app" boundary - it authenticates this personal app to your own backend,
# it is not a defense against a determined attacker with the compiled app.

# Must match API_KEY in backend/.env exactly.
EXPO_PUBLIC_API_KEY=replace-with-the-same-value-as-backend-API_KEY

# Base URL of the deployed (or local) backend, no trailing slash.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
