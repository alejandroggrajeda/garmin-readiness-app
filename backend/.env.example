# Copy to `.env` for local development. NEVER commit the real `.env` file
# (already covered by the root .gitignore). In production these are set as
# Render secret env vars (see ../render.yaml) - never as plain env in git.

# --- Database (Neon free tier) --------------------------------------------
# IMPORTANT: use Neon's DIRECT (non-pooled) endpoint, NOT the "-pooler" host.
# The advisory lock used for the sync mutex (pg_try_advisory_lock) is
# session-scoped and silently breaks under PgBouncer transaction pooling.
# Direct-endpoint hosts typically look like:
#   ep-xxxx-xxxx.us-east-1.aws.neon.tech
# (as opposed to the pooled form: ep-xxxx-xxxx-pooler.us-east-1.aws.neon.tech)
# sslmode=require is mandatory - Neon is only reachable over TLS.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456.us-east-1.aws.neon.tech/garmin_readiness?sslmode=require

# --- API auth ---------------------------------------------------------------
# Single-user app: one static API key, sent by the mobile client as
# X-API-Key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-generated-secret

# --- Garmin Connect credentials ---------------------------------------------
# Server-side only. Never sent to, or stored on, the mobile client.
# If Garmin ever requires MFA on this account, sync fails loudly instead of
# retry-looping - see design.md, "Auth failures fail loudly".
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=replace-with-your-garmin-password

# Fernet key used to encrypt the cached Garmin session token at rest in the
# garmin_session table. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_SECRET_KEY=replace-with-a-generated-fernet-key
